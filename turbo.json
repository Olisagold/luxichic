{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": [
        "SUPABASE_SECRET_KEY",
        "DATABASE_URL",
        "RESEND_API_KEY",
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_WEBHOOK_SECRET",
        "TELEGRAM_ADMIN_CHAT_ID",
        "CRON_SECRET",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT",
        "ADMIN_PATH",
        "VERCEL_ENV",
        "VERCEL_DEPLOYMENT_ID",
        "CI"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "outputs": []
    }
  }
}
