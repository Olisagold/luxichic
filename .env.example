# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Postgres (Supabase connection string, used by Drizzle)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=

# Resend (transactional email)
RESEND_API_KEY=

# The admin's secret address (8-40 lowercase letters, numbers or dashes), e.g. staff-k7x2m9. Set it only in
# Vercel, never commit it. When set, staff sign in at /<ADMIN_PATH> and /admin looks like a missing page to
# anyone not signed in. Leave empty locally: /admin works as usual.
ADMIN_PATH=
