{
  "name": "luxichic",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:seed": "tsx --tsconfig apps/web/tsconfig.json scripts/database/seed.ts",
    "db:create-owner": "tsx --tsconfig apps/web/tsconfig.json scripts/database/create-owner.ts",
    "db:load-catalog": "tsx --tsconfig apps/web/tsconfig.json scripts/database/load-catalog.ts",
    "db:media": "tsx --tsconfig apps/web/tsconfig.json scripts/database/media.ts",
    "db:set-payments": "tsx --tsconfig apps/web/tsconfig.json scripts/database/set-payments.ts",
    "db:set-promo": "tsx --tsconfig apps/web/tsconfig.json scripts/database/set-promo.ts"
  },
  "devDependencies": {
    "prettier": "^3",
    "supabase": "^2.120.0",
    "tsx": "^4.23.15",
    "turbo": "^2.0.0"
  }
}
